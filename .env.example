# PostgreSQL connection string (Neon / Supabase / local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ilovedecants?schema=public"

# Production / demo (Vercel + Neon): use Neon's DIRECT (non-pooled) connection string and keep ?sslmode=require
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# Optional: direct (non-pooled) URL used only by `prisma migrate` / seed. Required on Neon if DATABASE_URL is the "-pooler" string.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
